#!/usr/bin/env bash
###############################################################################
# functions.sh
#
# A collection of Bash functions to enhance your shell workflow.
# Functions are grouped by functionality, use proper error handling, and
# adhere to modern scripting best practices. This file is intended to be
# sourced from your shell startup file (e.g. ~/.bashrc or ~/.zshrc).
#
# Author: [Your Name]
# License: MIT
###############################################################################


###############################################################################
# Prevent Direct Execution
###############################################################################
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "This script is meant to be sourced, not executed directly."
    exit 1
fi

###############################################################################
# Prevent Direct Execution
###############################################################################
display_system_info() {
    for cmd in macchina neofetch archey fastfetch screenfetch linuxlogo; do
        if command -v "$cmd" &>/dev/null; then
            if [[ "$cmd" == "neofetch" && -f "$CONFIG_BASH_DIR/.neofetch.conf" ]]; then
                neofetch --config "$CONFIG_BASH_DIR/.neofetch.conf"
                printf '\e[A\e[K'  # Move cursor up one line after neofetch
            else
                "$cmd"
            fi
            return  # Exit function after first successful command
        fi
    done
}
###############################################################################
# Helper: Functions Help
###############################################################################
# functions_help
#
# Displays a comprehensive list of available functions along with a short
# description of what each does.
###############################################################################
helpme() {
    echo -e "${fg_bright_cyan}==============================================${clr_restore}"
