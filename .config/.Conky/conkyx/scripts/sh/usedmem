#!/bin/sh
# usedmem — Print used RAM in human-readable format
# Output: "X.XX GB" or "X.XX MB"

eval "$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "total=%d\navail=%d\n", t, a}' /proc/meminfo)"
bytes=$(( (total - avail) * 1024 ))

if [ "$bytes" -ge 1073741824 ]; then
    awk "BEGIN { printf \"%.2f GB\n\", $bytes / 1073741824 }"
elif [ "$bytes" -ge 1048576 ]; then
    awk "BEGIN { printf \"%.2f MB\n\", $bytes / 1048576 }"
else
    awk "BEGIN { printf \"%.2f KB\n\", $bytes / 1024 }"
fi
