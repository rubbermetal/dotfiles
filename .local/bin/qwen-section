#!/usr/bin/env python3
"""qwen-section: have the local Qwen model rewrite ONE section of a big file.

Usage:
  qwen-section [-m 7b|14b] (-s START [-e END] | -l A-B) [--ext EXT] [-t TESTS]
               [--timeout SEC] [--keep] [-n] SPEC_FILE TARGET

  -s START    regular expression matching exactly one line: the first line of the section.
              Without -e the section runs to the end of the { } block that starts there.
  -e END      regular expression: the first line after START that matches is the last line
  -l A-B      line numbers instead of patterns (1-based, inclusive)
  --ext EXT   extension for the part file the model edits (js for a script block inside
              an .html template); default: the target's own extension
  -t TESTS    pytest file/dir to run after the section is put back
  --keep      keep the part file (qwen-section-part.EXT beside the target)
  -n          dry run: show which lines would be handed over, call nothing

Examples:
  qwen-section -s 'function syncSideAxis\\(' --ext js spec.txt templates/index.html
  qwen-section -s '<!-- BEGIN nav -->' -e '<!-- END nav -->' spec.txt page.html
  qwen-section -l 120-180 -t tests/test_x.py spec.txt suite/app/routes.py
  qwen-section -n -s 'def build\\(' spec.txt routes.py

The model only ever sees the section (dedented, in a small file), so the size of the
target does not matter. The target is rewritten only when the model run succeeded and
the result passed the checks (not empty, braces still balanced).

Exit codes: 0 done (or no change), 2 bad arguments or section not found,
            3 the model run failed or its result was rejected (target untouched),
            4 tests failed after the change (target holds the new text).
"""
import argparse
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share", "qwen-build"))
from section import SectionError, extract, find_section, splice  # noqa: E402


def parse_lines(value):
    pieces = value.split("-")
    if len(pieces) != 2 or not all(p.isdigit() for p in pieces):
        raise SectionError("bad --lines value " + repr(value))
    return int(pieces[0]), int(pieces[1])


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-m", "--model", default="14b", choices=["7b", "14b"])
    ap.add_argument("-s", "--start", default=None)
    ap.add_argument("-e", "--end", default=None)
    ap.add_argument("-l", "--lines", default=None)
    ap.add_argument("--ext", default=None)
    ap.add_argument("-t", "--tests", default=None)
    ap.add_argument("--timeout", type=int, default=1200)
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("-n", "--dry-run", action="store_true")
    ap.add_argument("spec")
    ap.add_argument("target")
    a = ap.parse_args()

    if (a.start is None) == (a.lines is None):
        print("qwen-section: give -s START or -l A-B (one of them)")
        return 2
    if not os.path.isfile(a.target):
        print("qwen-section: no such file " + a.target)
        return 2
    if not a.dry_run and not os.path.isfile(a.spec):
        print("qwen-section: no such spec file " + a.spec)
        return 2
    with open(a.target, encoding="utf-8") as f:
        text = f.read()

    try:
        first, last = parse_lines(a.lines) if a.lines is not None else find_section(text, a.start, a.end)
        body, indent = extract(text, first, last)
    except SectionError as exc:
        print("qwen-section: " + str(exc))
        return 2
    count = last - first + 1
    print(f"qwen-section: {a.target} lines {first}-{last} ({count} lines)")

    if a.dry_run:
        print(body, end="")
        return 0

    ext = "." + a.ext.lstrip(".") if a.ext else os.path.splitext(a.target)[1]
    part = os.path.join(os.path.dirname(a.target), "qwen-section-part" + ext)
    if os.path.exists(part):
        print(f"qwen-section: {part} already exists (left by --keep or another run); remove it first")
        return 2
    with open(a.spec, encoding="utf-8") as f:
        user_spec = f.read().rstrip()
    note = (f"The file {part} is ONE SECTION cut out of {a.target} (lines {first}-{last}). It is not a whole "
            "program: other code around it exists and must keep working. Rewrite this section as asked below. "
            "Keep every function name, signature and line you are not asked to change. Do not add imports, "
            "wrappers or example code. Reply with the complete section.")
    work = tempfile.mkdtemp(prefix="qwen-section-")
    full_spec = os.path.join(work, "spec.txt")
    with open(full_spec, "w", encoding="utf-8") as f:
        f.write(note + "\n\n" + user_spec + "\n")
    with open(part, "w", encoding="utf-8") as f:
        f.write(body)

    build = os.environ.get("QWEN_BUILD", "qwen-build")
    cmd = [build, "-m", a.model, "--rules", "none", "--no-lint", "--timeout", str(a.timeout), full_spec, part]
    sys.stdout.flush()
    try:
        rc = subprocess.run(cmd).returncode
        new_body = ""
        if os.path.exists(part):
            with open(part, encoding="utf-8") as f:
                new_body = f.read()
    finally:
        if not a.keep and os.path.exists(part):
            os.remove(part)

    if rc != 0:
        print(f"  qwen-build failed (exit {rc}); {a.target} not changed")
        return 3
    if new_body.strip() == "":
        print(f"  empty result; {a.target} not changed")
        return 3
    if new_body.rstrip("\n") == body.rstrip("\n"):
        print("  no change")
        return 0
    if body.count("{") == body.count("}") and new_body.count("{") != new_body.count("}"):
        print(f"  rejected: unbalanced braces in the new section; {a.target} not changed")
        return 3

    with open(a.target, "w", encoding="utf-8") as f:
        f.write(splice(text, first, last, new_body, indent))
    new_count = len(new_body.rstrip("\n").split("\n"))
    print(f"  replaced {count} lines with {new_count}")

    if a.tests:
        t = subprocess.run([sys.executable, "-m", "pytest", "-q", a.tests], capture_output=True, text=True)
        out_lines = t.stdout.strip().splitlines()
        print(f"  tests ({a.tests}): {out_lines[-1] if out_lines else '?'}")
        if t.returncode != 0:
            return 4
    return 0


if __name__ == "__main__":
    sys.exit(main())
