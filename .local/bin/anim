#!/usr/bin/env python3
"""Launcher for anim. The code lives in ../share/anim/ next to the real file, so this works through a symlink.

Usage: anim mv -vi report.txt ~/docs/
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share", "anim"))
from anim import main  # noqa: E402

sys.exit(main())
