## Ruby.

syntax ruby "\.rb$|(^|/)(Gemfile|Rakefile|Capfile|Vagrantfile)$"
header "^#!.*\<ruby"
magic "Ruby script"
comment "#"

color sand "^[[:blank:]]*(def|class|module)[[:blank:]]+[[:alpha:]_][[:alnum:]_:?!]*"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<[[:upper:]][[:alnum:]_]*\>"
color lagoon "\<(alias|and|begin|break|case|class|def|defined\?|do|else|elsif|end|ensure|for|if|in|module|next|nil|not|or|redo|rescue|retry|return|self|super|then|undef|unless|until|when|while|yield)\>"
color mauve "\<(true|false|nil|__FILE__|__LINE__|__ENCODING__)\>"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]*)?)\>"
color purple "^[[:blank:]]*:[\"']?[[:alpha:]_][[:alnum:]_]*[\"']?"
color sky "[:@][:@]?[[:alpha:]_][[:alnum:]_]*"
color sky "\$[[:alpha:]_][[:alnum:]_]*"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)*'"
color orange "\\([abfnrtv\\'\"#]|[0-7]{1,3}|x[[:xdigit:]]{1,2})"
color italic,grey "(^|[[:blank:]])#.*"
color italic,grey start="^=begin" end="^=end"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
