## PHP.

syntax php "\.(php[34578s]?|phtml|phar|inc)$"
header "^[[:blank:]]*<\?php"
magic "PHP script"
comment "//"

color rosy "<\?(php|=)?|\?>"
color sand "^[[:blank:]]*(public|protected|private|static|final|abstract)?[[:blank:]]*function[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<(array|bool|boolean|callable|float|double|int|integer|iterable|mixed|never|object|string|void|self|parent|static|false|null|true)\>"
color lagoon "\<(abstract|and|as|break|case|catch|clone|const|continue|declare|default|die|do|echo|else|elseif|empty|enddeclare|endfor|endforeach|endif|endswitch|endwhile|enum|eval|exit|extends|final|finally|fn|for|foreach|function|global|goto|if|implements|include|include_once|instanceof|insteadof|interface|isset|list|match|namespace|new|or|print|private|protected|public|readonly|require|require_once|return|switch|throw|trait|try|unset|use|var|while|xor|yield)\>"
color mauve "\<__(CLASS|DIR|FILE|FUNCTION|LINE|METHOD|NAMESPACE|TRAIT)__\>"
color sky "\$[[:alpha:]_][[:alnum:]_]*"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|[0-9][0-9_]*(\.[0-9_]+)?)\>"
color purple "#\[[[:alpha:]_]"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)*'"
color orange "\\([abfnrtv\\'\"$]|[0-7]{1,3}|x[[:xdigit:]]{1,2}|u\{[[:xdigit:]]+\})"
color italic,grey "(^|[[:blank:]])(#|//).*"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
