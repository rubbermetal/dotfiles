## JavaScript and TypeScript.

syntax javascript "\.(js|mjs|cjs|jsx|ts|tsx|mts|cts)$"
header "^#!.*/(node|bun|deno)\>"
magic "JavaScript source"
comment "//"

color sand "^[[:blank:]]*(export[[:blank:]]+)?(async[[:blank:]]+)?function[[:blank:]]+\*?[[:alpha:]_][[:alnum:]_]*"
color sand "^[[:blank:]]*(export[[:blank:]]+)?class[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<[[:upper:]][[:lower:][:digit:]]*[[:alnum:]]*\>"
color teal "\<(any|bigint|boolean|never|number|object|string|symbol|undefined|unknown)\>"
color lagoon "\<(abstract|as|async|await|break|case|catch|class|const|continue|debugger|declare|default|delete|do|else|enum|export|extends|finally|for|from|function|if|implements|import|in|instanceof|interface|is|keyof|let|namespace|new|of|override|package|private|protected|public|readonly|return|satisfies|static|super|switch|this|throw|try|type|typeof|var|void|while|with|yield)\>"
color mauve "\<(true|false|null|undefined|NaN|Infinity)\>"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?)\>"
color purple "^[[:blank:]]*@[[:alpha:]_][[:alnum:]_.]*"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)*'"
color mint "`([^`\\]|\\.)*`"
color orange "\\([abfnrtv\\'\"`]|[0-7]{1,3}|x[[:xdigit:]]{2}|u[[:xdigit:]]{4}|u\{[[:xdigit:]]+\})"
color italic,grey "(^|[[:blank:]])//.*"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
