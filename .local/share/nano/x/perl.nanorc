## Perl.

syntax perl "\.(p[lm]|t|pod|perl)$"
header "^#!.*\<perl"
magic "Perl script"
comment "#"

color sand "^[[:blank:]]*sub[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color lagoon "\<(and|cmp|continue|do|else|elsif|eq|for|foreach|ge|given|goto|gt|if|isa|last|le|lt|ne|next|not|or|package|redo|return|unless|until|when|while|xor)\>"
color teal "\<(bless|caller|chomp|chop|chr|close|closedir|defined|delete|die|each|eof|eval|exists|exit|fork|gmtime|grep|hex|index|int|join|keys|kill|lc|lcfirst|length|local|localtime|map|mkdir|my|no|oct|open|opendir|ord|our|pack|pipe|pop|pos|print|printf|prototype|push|quotemeta|rand|read|readdir|readline|readlink|ref|rename|require|reverse|rindex|rmdir|say|scalar|seek|select|shift|sleep|sort|splice|split|sprintf|sqrt|srand|stat|state|study|sub|substr|symlink|sysread|syswrite|tell|tie|tied|time|uc|ucfirst|umask|undef|unlink|unpack|unshift|untie|use|values|vec|wait|waitpid|wantarray|warn|write)\>"
color mauve "\<(ARGV|DATA|STDERR|STDIN|STDOUT|__FILE__|__LINE__|__PACKAGE__|__SUB__)\>"
color sky "[$@%]#?[[:alpha:]_][[:alnum:]_]*"
color sky "[$@%]\{[[:alpha:]_][[:alnum:]_]*\}"
color sky "\$[#][[:digit:][:alpha:]_]+"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|[0-9][0-9_]*(\.[0-9_]+)?)\>"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)*'"
color orange "\\([abfnrtv\\'\"$]|[0-7]{1,3}|x[[:xdigit:]]{2}|x\{[[:xdigit:]]+\})"
color italic,grey "(^|[[:blank:]])#.*"
color italic,grey start="^=(pod|head[1-4]|over|item|back|begin|for|encoding)" end="^=cut"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
