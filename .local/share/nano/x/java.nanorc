## Java.

syntax java "\.java$"
magic "Java source"
comment "//"

color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<(boolean|byte|char|double|float|int|long|short|var|void)\>"
color teal "\<[[:upper:]][[:lower:][:digit:]]*[[:alnum:]]*\>"
color lagoon "\<(abstract|assert|break|case|catch|class|const|continue|default|do|else|enum|extends|final|finally|for|goto|if|implements|import|instanceof|interface|native|new|package|permits|private|protected|public|record|return|sealed|static|strictfp|super|switch|synchronized|this|throw|throws|transient|try|volatile|when|while|yield)\>"
color mauve "\<(true|false|null)\>"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?[lLfFdD]?)\>"
color purple "^[[:blank:]]*@[[:alpha:]_][[:alnum:]_.]*"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)*'"
color mint start="\"\"\"" end="\"\"\""
color orange "\\([abfnrtv\\'\"]|[0-7]{1,3}|x[[:xdigit:]]+|u[[:xdigit:]]{4})"
color italic,grey "(^|[[:blank:]])//.*"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
