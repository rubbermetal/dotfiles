## C and C++. 256-color rules for an X terminal.

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?|ipp|tcc)$"
header "^#!.*/(tcc|g?cc)\>"
header "-\*-.*(C(\+\+)?|c(\+\+)?).*-\\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<(bool|char|char(8|16|32)_t|double|float|int|long|short|signed|unsigned|void|wchar_t|_(Bool|Complex|Decimal(32|64|128)|Imaginary|BitInt))\>"
color teal "\<(u?int(_fast|_least)?(8|16|32|64)_t|u?intmax_t|u?intptr_t|size_t|ssize_t|ptrdiff_t|off_t|time_t|FILE|nullptr_t)\>"
color teal "\<(auto|class|concept|enum|namespace|struct|template|typename|union|using)\>"
color teal "\<(string|string_view|vector|map|array|optional|variant|tuple|function|unique_ptr|shared_ptr|span)\>"
color lagoon "\<(alignas|alignof|asm|break|case|catch|co_await|co_return|co_yield|const|consteval|constexpr|constinit|continue|decltype|default|delete|do|else|explicit|export|extern|final|for|friend|goto|if|import|inline|module|mutable|new|noexcept|operator|override|private|protected|public|register|requires|restrict|return|sizeof|static|static_assert|switch|this|thread_local|throw|try|typedef|typeid|typeof|typeof_unqual|virtual|volatile|while)\>"
color lagoon "\<(_(Alignas|Alignof|Atomic|Generic|Noreturn|Static_assert|Thread_local))\>"
color mauve "\<(NULL|EOF|true|false|nullptr|TRUE|FALSE)\>"
color mauve "\<[[:upper:]][[:upper:][:digit:]_]{1,}\>"
color peach "\<(0[xX][[:xdigit:]']+|0[bB][01']+|[0-9][0-9']*(\.[0-9']+)?([eE][+-]?[0-9']+)?)([uUlLfF]|[uU][lL]{1,2}|[lL]{1,2}[uU])?\>"
color rosy "^[[:blank:]]*#[[:blank:]]*(include(_next)?|define|undef|if|ifdef|ifndef|elif|elifdef|elifndef|else|endif|error|warning|pragma|line|embed)\>"
color rosy "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"
color purple "\[\[[[:alpha:]_].*\]\]"
color mint "([uUL]8?|u8)?\"([^\"\\]|\\.)*\""
color mint "([uUL]|u8)?'([^'\\]|\\.)*'"
color orange "\\([abfnrtv\\'\"?]|[0-7]{1,3}|x[[:xdigit:]]+|u[[:xdigit:]]{4}|U[[:xdigit:]]{8})"
color italic,grey "(^|[[:blank:]])//.*"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
