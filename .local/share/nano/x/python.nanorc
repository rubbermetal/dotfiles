## Python. 256-color rules for an X terminal.

syntax python "\.py[iw]?$"
header "^#!.*\<python"
magic "Python script"
comment "#"

color sand "^[[:blank:]]*(async[[:blank:]]+)?def[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "^[[:blank:]]*class[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<[[:upper:]][[:lower:][:digit:]]*[[:alnum:]]*\>"
color teal "\<(bool|bytearray|bytes|complex|dict|float|frozenset|int|list|object|set|str|tuple|type)\>"
color lagoon "\<(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\>"
color lagoon "\<(match|case)[[:blank:]]"
color mauve "\<(False|None|True|NotImplemented|Ellipsis|\.\.\.)\>"
color peach "\<([0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?[jJ]?|0[xX][[:xdigit:]_]+|0[bB][01_]+|0[oO][0-7_]+)\>"
color purple "^[[:blank:]]*@[[:alpha:]_][[:alnum:]_.]*"
color sky "\<(self|cls)\>"
color mint "([rRbuUBf]{1,3})?'([^'\\]|\\.)*'"
color mint "([rRbuUBf]{1,3})?\"([^\"\\]|\\.)*\""
color mint start="([rRbuUBf]{1,3})?'''" end="'''"
color mint start="([rRbuUBf]{1,3})?\"\"\"" end="\"\"\""
color orange "\\([abfnrtv\\'\"\n]|[0-7]{1,3}|x[[:xdigit:]]{2}|u[[:xdigit:]]{4}|U[[:xdigit:]]{8}|N\{[^}]*\})"
color italic,grey "(^|[[:blank:]])#.*"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
