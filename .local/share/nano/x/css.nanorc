## CSS and the Sass/Less cousins.

syntax css "\.(css|scss|sass|less)$"
comment "/*|*/"

color sand "[:.]?[[:alpha:]_-][[:alnum:]_-]*[[:blank:]]*\{"
color teal "[[:alpha:]-]+[[:blank:]]*:"
color peach "#[0-9A-Fa-f]{3,8}\>"
color peach "\<[0-9]+(\.[0-9]+)?(px|em|rem|vh|vw|vmin|vmax|%|ch|ex|pt|pc|in|cm|mm|s|ms|deg|fr)?\>"
color mauve "\<(inherit|initial|unset|revert|none|auto)\>"
color rosy "!important"
color mint "\"[^\"\\]*\""
color mint "'[^'\\]*'"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
