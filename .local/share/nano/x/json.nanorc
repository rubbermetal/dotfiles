## JSON, plus the comment forms used by JSONC.

syntax json "\.json[c5]?$"
magic "JSON data"
comment ""

color peach "\<(-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)\>"
color mauve "\<(true|false|null)\>"
color mint "\"([^\"\\]|\\.)*\""
color sky "\"([^\"\\]|\\.)*\"[[:blank:]]*:"
color orange "\\([\"\\/bfnrt]|u[[:xdigit:]]{4})"
color italic,grey "(^|[[:blank:]])//.*"
color italic,grey start="/\*" end="\*/"
color ,brick "[[:space:]]+$"
