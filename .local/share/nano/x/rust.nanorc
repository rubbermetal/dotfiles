## Rust.

syntax rust "\.rs$"
header "-\*-.*rust.*-\\*-"
magic "Rust source"
comment "//"

color sand "^[[:blank:]]*(pub[[:blank:]]+)?(async[[:blank:]]+)?fn[[:blank:]]+[[:alpha:]_][[:alnum:]_]*"
color sand "[[:alpha:]_][[:alnum:]_]*!"
color sand "\<[[:alpha:]_][[:alnum:]_]*[[:space:]]*\("
color teal "\<(bool|char|str|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64)\>"
color teal "\<[[:upper:]][[:lower:][:digit:]]*[[:alnum:]]*\>"
color lagoon "\<(as|async|await|break|const|continue|crate|dyn|else|enum|extern|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|type|unsafe|use|where|while)\>"
color mauve "\<(true|false|Some|None|Ok|Err|Self)\>"
color peach "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?)\>"
color rosy "^[[:blank:]]*#!?\["
color sky "'[[:lower:]_][[:alnum:]_]*"
color mint "\"([^\"\\]|\\.)*\""
color mint "'([^'\\]|\\.)'"
color mint start="r#+\"\"" end="\"#+"
color orange "\\([abfnrtv\\'\"0]|x[[:xdigit:]]{2}|u\{[[:xdigit:]]+\})"
color italic,grey "(^|[[:blank:]])//.*"
color italic,grey start="/\*" end="\*/"
color bold,black,yellow "\<(FIXME|TODO|XXX|NOTE)\>"
color ,brick "[[:space:]]+$"
